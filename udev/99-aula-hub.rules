# Allow non-root desktop users (WebHID / hidapi) access to AULA keyboards, mice, and dongles.
# All 79 VID:PID pairs are extracted from AULA HUB's device registry (excluding headsets).

# WIN 68 HE / WIN 60 HE (RuiLianWei)
KERNEL=="hidraw*", ATTRS{idVendor}=="2e3c", ATTRS{idProduct}=="c365", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="2e3c", ATTR{idProduct}=="c365", MODE="0666", TAG+="uaccess"

